# Google Gemini API Keys for Rate Limit Rotation
# Get these from: https://aistudio.google.com/
# At least GEMINI_API_KEY_1 is required. Adding more keys (2 & 3) reduces rate-limit errors.
GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here

# Tavily Search API Key (Required)
# Get this from: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# (Optional) LangSmith Tracing for debugging your LangGraph agent
# Get this from: https://smith.langchain.com/
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=fact_checker_project